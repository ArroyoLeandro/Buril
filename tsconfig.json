{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // The browser tests and the Vitest configs load Vitest's browser matchers, whose types clash
  // with jest-dom's; tsconfig.browser.json checks them.
  "exclude": [
    "dist",
    "public/r",
    "**/*.browser.test.tsx",
    "test/browser.ts",
    "test/docs-site.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/lib/*": ["./registry/lib/*"]
    }
  }
}
