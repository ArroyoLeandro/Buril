{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "buril",
  "homepage": "https://example.com/buril-ui",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn() helper: clsx plus tailwind-merge.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Buril theme",
      "description": "Buril design tokens: red lacquer palette with light and dark schemes.",
      "css": {
        "@media (prefers-color-scheme: dark)": {
          ":root:not(.light)": {
            "color-scheme": "dark",
            "--background": "#161310",
            "--foreground": "#ede6da",
            "--card": "#161310",
            "--card-foreground": "#ede6da",
            "--popover": "#161310",
            "--popover-foreground": "#ede6da",
            "--primary": "#ff5a51",
            "--primary-foreground": "#161310",
            "--muted-foreground": "#b5ada0",
            "--border": "#ede6da",
            "--ring": "#ff5a51",
            "--decor": "#d72828",
            "--grid": "color-mix(in oklab, #ede6da 7%, transparent)"
          }
        },
        "@custom-variant dark": {
          "&:where(.dark, .dark *)": {
            "@slot": {}
          },
          "@media (prefers-color-scheme: dark)": {
            "&:where(:root:not(.light), :root:not(.light) *)": {
              "@slot": {}
            }
          }
        },
        ":root": {
          "color-scheme": "light",
          "--muted-foreground": "color-mix(in oklab, #1a1714 72%, #f4efe6)",
          "--grid": "color-mix(in oklab, #1a1714 9%, transparent)"
        },
        ".dark": {
          "color-scheme": "dark",
          "--muted-foreground": "#b5ada0",
          "--grid": "color-mix(in oklab, #ede6da 7%, transparent)"
        }
      },
      "cssVars": {
        "theme": {
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-border": "var(--border)",
          "color-ring": "var(--ring)",
          "color-decor": "var(--decor)",
          "color-grid": "var(--grid)",
          "font-display": "ui-monospace, monospace",
          "font-body": "system-ui, sans-serif"
        },
        "light": {
          "background": "#f4efe6",
          "foreground": "#1a1714",
          "card": "#f4efe6",
          "card-foreground": "#1a1714",
          "popover": "#f4efe6",
          "popover-foreground": "#1a1714",
          "primary": "#c90f1a",
          "primary-foreground": "#ffffff",
          "border": "#1a1714",
          "ring": "#c90f1a",
          "decor": "#d72828"
        },
        "dark": {
          "background": "#161310",
          "foreground": "#ede6da",
          "card": "#161310",
          "card-foreground": "#ede6da",
          "popover": "#161310",
          "popover-foreground": "#ede6da",
          "primary": "#ff5a51",
          "primary-foreground": "#161310",
          "border": "#ede6da",
          "ring": "#ff5a51",
          "decor": "#d72828"
        }
      }
    }
  ]
}
