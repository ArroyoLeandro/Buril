---
/**
 * Renders docs text where `backticks` mark inline code. Code over 24 characters may wrap, so it
 * cannot overflow a phone; shorter code never wraps (see `src/styles/global.css`).
 */
interface Props {
  text: string;
}

const parts = Astro.props.text.split(/`([^`]+)`/);
---

{parts.map((part, index) =>
  index % 2 === 1 ? <code data-wrap={part.length > 24 ? "" : undefined}>{part}</code> : part,
)}
