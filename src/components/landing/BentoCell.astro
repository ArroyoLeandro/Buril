---
import Icon from "../icons/Icon.astro";
import { cn } from "@/lib/utils";
import { localizedHref } from "../../i18n/paths";
import { getLocale, translator } from "../../i18n/ui";

/**
 * One cell of the landing bento: a pixel-font label that names the cell, an optional caption, a
 * quiet "View code" link to the component page, then the block. Every cell sits on explicit grid
 * lines from lg up, in source order, so the reading order and the Tab order match what the eye
 * sees. Below lg the cells flow: one column, then two.
 */
export type CellId = "team" | "settings" | "checkbox" | "field" | "alert" | "buttons" | "gestures";

interface Props {
  id: CellId;
  label: string;
  caption?: string;
  /** The component page the "View code" link opens. */
  component: { slug: string; name: string };
  /** A faint border, no border at all, or a faint tint. */
  tone?: "line" | "bare" | "tint";
  /** A paper grid that fades out from one corner. */
  paper?: "top-right" | "bottom-left";
  class?: string;
}

const { id, label, caption, component, tone = "line", paper, class: className } = Astro.props;
const locale = getLocale(Astro.url);
const t = translator(locale);

const placement: Record<CellId, string> = {
  team: "sm:col-span-2 max-lg:h-[440px] lg:col-[1/4] lg:row-[1/3]",
  settings: "sm:col-span-2 max-lg:h-[540px] lg:col-[4/10] lg:row-[1/3]",
  checkbox: "lg:col-[10/13] lg:row-[1]",
  field: "lg:col-[10/13] lg:row-[2]",
  alert: "lg:col-[1/4] lg:row-[3]",
  buttons: "lg:col-[4/10] lg:row-[3]",
  gestures: "sm:col-span-2 lg:col-[10/13] lg:row-[3]",
};

const tones = {
  line: "border-border/15 bg-background",
  bare: "border-transparent",
  tint: "border-transparent bg-muted/55",
};

const papers = {
  "top-right": "before:[mask-image:radial-gradient(110%_80%_at_100%_0%,#000,transparent_75%)]",
  "bottom-left": "before:[mask-image:radial-gradient(110%_90%_at_0%_100%,#000,transparent_75%)]",
};
---

<article
  data-cell={id}
  aria-labelledby={`cell-${id}`}
  class={cn(
    "relative isolate flex min-h-[196px] min-w-0 flex-col gap-1 overflow-hidden rounded-xl border p-5",
    tones[tone],
    paper && [
      "before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:bg-paper-grid before:content-['']",
      papers[paper],
    ],
    placement[id],
    className,
  )}
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 id={`cell-${id}`} class="font-display text-xs leading-4 tracking-[0.04em]">
      {label}
    </h3>
    <a
      data-view-code
      href={localizedHref(`/docs/components/${component.slug}`, locale)}
      class="inline-flex min-h-6 shrink-0 items-center gap-1 rounded-xs text-xs whitespace-nowrap text-muted-foreground underline-offset-3 hover:text-foreground hover:underline"
    >
      {t("landing.viewCode")}
      <span class="sr-only" set:text={` ${t("landing.viewCodeFor", { name: component.name })}`} />
      <Icon name="arrow-right" class="size-3" />
    </a>
  </div>
  {caption && <p class="max-w-[34ch] text-sm text-muted-foreground">{caption}</p>}
  <slot />
</article>
