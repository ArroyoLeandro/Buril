---
import BentoCell from "./BentoCell.astro";
import Engraving from "../Engraving.astro";
import CheckboxBlock from "../showcase/CheckboxBlock";
import FieldBlock from "../showcase/FieldBlock";
import SettingsBlock from "../showcase/SettingsBlock";
import AlertBlock from "../showcase/AlertBlock";
import ButtonsBlock from "../showcase/ButtonsBlock";
import GesturesBlock from "../showcase/GesturesBlock";
import TeamBlock from "../showcase/TeamBlock";
import { getLocale, translator } from "../../i18n/ui";

/**
 * The landing showcase: real Buril components composed into small app scenes, on a bento grid of
 * 12 columns (3 | 6 | 3) capped at 1320px. Cells are in reading order; the grid places them on
 * explicit lines from lg up. Blocks built from native controls are static HTML; only a block that
 * needs state hydrates, when it scrolls into view, so the showcase never competes with the hero.
 */
const locale = getLocale(Astro.url);
const t = translator(locale);
---

<section data-showcase aria-labelledby="showcase-title" class="px-4 pt-4 pb-20 sm:px-6">
  <h2 id="showcase-title" class="sr-only">
    {t("landing.showcase")}
  </h2>
  <div
    data-bento
    class="mx-auto grid max-w-[1320px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-[252px_252px_236px]"
  >
    <BentoCell
      id="team"
      label={t("landing.cellTeam")}
      caption={t("landing.captionTeam")}
      component={{ slug: "avatar", name: "Avatar" }}
    >
      <TeamBlock locale={locale} />
    </BentoCell>
    <BentoCell
      id="settings"
      label={t("landing.cellSettings")}
      caption={t("landing.captionSettings")}
      component={{ slug: "switch", name: "Switch" }}
    >
      <Engraving
        clipId="engraving-settings"
        thin={0.3}
        bold={0.8}
        class="pointer-events-none absolute -top-[250px] -right-[230px] -z-10 w-[560px] max-w-none opacity-15 [mask-image:radial-gradient(closest-side,transparent_32%,#000_52%,transparent_100%)] dark:opacity-20"
      />
      <SettingsBlock locale={locale} />
    </BentoCell>
    <BentoCell
      id="checkbox"
      label={t("landing.cellCheckbox")}
      caption={t("landing.captionCheckbox")}
      component={{ slug: "checkbox", name: "Checkbox" }}
      tone="bare"
      paper="top-right"
    >
      <CheckboxBlock locale={locale} />
    </BentoCell>
    <BentoCell
      id="field"
      label={t("landing.cellField")}
      caption={t("landing.captionField")}
      component={{ slug: "field", name: "Field" }}
      tone="tint"
    >
      <FieldBlock locale={locale} client:visible />
    </BentoCell>
    <BentoCell
      id="alert"
      label={t("landing.cellAlert")}
      component={{ slug: "alert", name: "Alert" }}
      tone="bare"
      paper="bottom-left"
    >
      <AlertBlock locale={locale} />
    </BentoCell>
    <BentoCell
      id="buttons"
      label={t("landing.cellButtons")}
      caption={t("landing.captionButtons")}
      component={{ slug: "button", name: "Button" }}
      tone="tint"
    >
      <ButtonsBlock locale={locale} />
    </BentoCell>
    <BentoCell
      id="gestures"
      label={t("landing.cellGestures")}
      caption={t("landing.captionGestures")}
      component={{ slug: "icon-button", name: "IconButton" }}
    >
      <GesturesBlock locale={locale} client:visible />
    </BentoCell>
  </div>
</section>
