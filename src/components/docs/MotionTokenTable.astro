---
import TableScroll from "./TableScroll.astro";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

import InlineCode from "../InlineCode.astro";
import { motionTokenUses } from "../../data/motion";
import { getLocale, translator } from "../../i18n/ui";
import { readMotionTokens } from "../../utils/tokens";

/**
 * The motion tokens with their values, read from the file the registry ships, so the table never
 * drifts from the real values. Read from the project root, like the Theming page's token table.
 */
const locale = getLocale(Astro.url);
const t = translator(locale);
const tokens = readMotionTokens(readFileSync(resolve("registry/styles/buril.css"), "utf8"));
const cell = "px-2 py-3 align-top sm:px-4";
---

<TableScroll labelledby="motion-tokens-caption">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="motion-tokens-caption" class="px-2 py-3 text-left text-muted-foreground sm:px-4">
      <InlineCode text={t("motion.tokensCaption")} />
    </caption>
    <thead>
      <tr class="border-y border-border">
        <th scope="col" class={`${cell} font-semibold`}>
          {t("tokens.token")}
        </th>
        <th scope="col" class={`${cell} font-semibold`}>
          {t("motion.value")}
        </th>
        <th scope="col" class={`${cell} font-semibold`}>
          {t("motion.use")}
        </th>
      </tr>
    </thead>
    <tbody>
      {tokens.map(({ name, value }) => (
        <tr class="border-b border-border last:border-b-0">
          <th scope="row" class={`${cell} font-normal whitespace-nowrap`}>
            <code>--{name}</code>
          </th>
          <td class={cell}>
            {/* A long value such as a linear() curve breaks between its values, never inside one. */}
            <code class="whitespace-normal">
              {value.split(" ").map((word, index) => (
                <>
                  {index > 0 && " "}
                  <span class="whitespace-nowrap">{word}</span>
                </>
              ))}
            </code>
          </td>
          {/* Wide enough to read when the table scrolls on a phone. */}
          <td class={`${cell} min-w-48`}>
            <InlineCode text={motionTokenUses[name]?.[locale] ?? ""} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</TableScroll>
