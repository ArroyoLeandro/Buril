---
import TableScroll from "./TableScroll.astro";
import InlineCode from "../InlineCode.astro";
import { accessibilityChecks } from "../../data/accessibility";
import { getLocale, translator } from "../../i18n/ui";

/** Every kind of check behind the rules, what it does and whether it runs today. */
const locale = getLocale(Astro.url);
const t = translator(locale);
const cell = "px-2 py-3 align-top sm:px-4";
---

<TableScroll labelledby="checks-caption">
  <table class="w-full border-collapse text-left text-sm">
    <caption id="checks-caption" class="px-2 py-3 text-left text-muted-foreground sm:px-4">
      {t("a11y.checksCaption")}
    </caption>
    <thead>
      <tr class="border-y border-border">
        <th scope="col" class={`${cell} w-1/4 font-semibold`}>
          {t("a11y.check")}
        </th>
        <th scope="col" class={`${cell} font-semibold`}>
          {t("a11y.whatItDoes")}
        </th>
        <th scope="col" class={`${cell} font-semibold`}>
          {t("a11y.status")}
        </th>
      </tr>
    </thead>
    <tbody>
      {Object.values(accessibilityChecks).map((check) => (
        <tr class="border-b border-border last:border-b-0">
          <th scope="row" class={`${cell} font-semibold`}>
            {check.name[locale]}
          </th>
          <td class={cell}>
            <InlineCode text={check.description[locale]} />
          </td>
          <td class={`${cell} whitespace-nowrap`}>
            {check.status === "pending" ? (
              <strong>{t("a11y.pending")}</strong>
            ) : (
              t("a11y.automated")
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</TableScroll>
