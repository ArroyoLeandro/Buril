---
import InlineCode from "../InlineCode.astro";
import { changelog } from "../../data/changelog";
import { getLocale } from "../../i18n/ui";

/** Every changelog entry, newest first: a heading, the date and the changes. */
const locale = getLocale(Astro.url);
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "UTC" });
---

{changelog.map((entry) => (
  <>
    <h2 class="mt-10 font-display text-xl">
      <InlineCode text={entry.title[locale]} />
    </h2>
    <p class="mt-2 text-sm text-muted-foreground">
      <time datetime={entry.date}>{dateFormat.format(new Date(`${entry.date}T00:00:00Z`))}</time>
    </p>
    <ul class="mt-4 list-disc space-y-2 pl-6">
      {entry.changes[locale].map((change) => (
        <li>
          <InlineCode text={change} />
        </li>
      ))}
    </ul>
  </>
))}
