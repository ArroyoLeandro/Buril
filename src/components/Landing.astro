---
import BaseLayout from "../layouts/BaseLayout.astro";
import Engraving from "./Engraving.astro";
import InlineCode from "./InlineCode.astro";
import InstallCommand from "./InstallCommand.astro";
import ButtonsPanel from "./showcase/ButtonsPanel";
import SettingsPanel from "./showcase/SettingsPanel";
import SignInPanel from "./showcase/SignInPanel";
import { cn } from "@/lib/utils";
import { Alert, AlertDescription, AlertTitle } from "../../registry/ui/alert";
import { Badge } from "../../registry/ui/badge";
import { buttonVariants } from "../../registry/ui/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "../../registry/ui/card";
import { Link } from "../../registry/ui/link";
import { localizedHref } from "../i18n/paths";
import { getLocale, translator } from "../i18n/ui";

/**
 * The landing page, shared by `/` and `/es/`. The language comes from the URL; the copy comes
 * from the UI dictionary and the live panels get the same locale.
 */
const locale = getLocale(Astro.url);
const t = translator(locale);
const href = (path: string) => localizedHref(path, locale);

const principles = [
  { title: t("landing.ownTitle"), body: t("landing.ownBody") },
  { title: t("landing.accessibleTitle"), body: t("landing.accessibleBody") },
  { title: t("landing.platformTitle"), body: t("landing.platformBody") },
  { title: t("landing.themeableTitle"), body: t("landing.themeableBody") },
];

const container = "mx-auto w-full max-w-6xl px-4 sm:px-6";
const sectionTitle = "font-display text-2xl";
// Component names are code identifiers, so the badges stay in English.
const panels = [
  {
    id: "panel-sign-in",
    title: t("landing.panelSignIn"),
    uses: ["Field", "Input", "Checkbox", "Button"],
  },
  {
    id: "panel-settings",
    title: t("landing.panelSettings"),
    uses: ["Field", "Switch", "Radio Group", "Select"],
  },
  { id: "panel-buttons", title: t("landing.panelButtons"), uses: ["Button"] },
];
---

<BaseLayout title="Buril UI" footer>
  <section class="bg-paper-grid border-b border-border">
    <div class={cn(container, "grid items-center gap-10 py-14 md:grid-cols-[1.2fr_1fr] md:py-20")}>
      <div>
        <h1 class="font-display text-5xl leading-none sm:text-6xl">Buril UI</h1>
        <p class="mt-6 max-w-xl text-xl">{t("landing.lead")}</p>
        <p class="mt-4 max-w-xl text-muted-foreground">{t("landing.sublead")}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={href("/docs")} class={buttonVariants({ size: "lg" })}>
            {t("landing.getStarted")}
          </a>
          <a
            href={href("/docs/components")}
            class={buttonVariants({ variant: "outline", size: "lg" })}
          >
            {t("nav.components")}
          </a>
        </div>
      </div>
      <Engraving class="mx-auto w-full max-w-sm md:max-w-md" />
    </div>
  </section>

  <section aria-labelledby="why" class={cn(container, "py-16")}>
    <h2 id="why" class={sectionTitle}>
      {t("landing.why")}
    </h2>
    <ul class="mt-8 grid border-t border-l border-border sm:grid-cols-2 lg:grid-cols-4">
      {principles.map(({ title, body }) => (
        <li class="border-r border-b border-border p-6">
          <h3 class="font-display text-base">{title}</h3>
          <p class="mt-3 text-sm text-muted-foreground">{body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="at-work" class="border-y border-border bg-secondary/40 py-16">
    <div class={container}>
      <h2 id="at-work" class={sectionTitle}>
        {t("landing.atWork")}
      </h2>
      <p class="mt-4 max-w-2xl text-muted-foreground">{t("landing.atWorkBody")}</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {panels.map(({ id, title, uses }) => (
          <Card decor className="min-w-0">
            <CardHeader>
              <CardTitle id={id} className="font-display text-base">
                {title}
              </CardTitle>
            </CardHeader>
            <CardContent>
              {id === "panel-sign-in" && <SignInPanel locale={locale} client:visible />}
              {id === "panel-settings" && <SettingsPanel locale={locale} client:visible />}
              {id === "panel-buttons" && <ButtonsPanel locale={locale} client:visible />}
            </CardContent>
            <CardFooter className="mt-auto">
              <ul aria-label={t("landing.componentsUsed")} class="flex flex-wrap gap-2">
                {uses.map((name) => (
                  <li>
                    <Badge variant="outline">{name}</Badge>
                  </li>
                ))}
              </ul>
            </CardFooter>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="install" class={cn(container, "py-16")}>
    <h2 id="install" class={sectionTitle}>
      {t("landing.install")}
    </h2>
    <p class="mt-4 max-w-2xl text-muted-foreground">{t("landing.installBody")}</p>
    <div class="max-w-3xl">
      <Alert className="mt-6">
        <AlertTitle>{t("landing.requirementTitle")}</AlertTitle>
        <AlertDescription>
          <InlineCode text={t("landing.requirementBody")} />
        </AlertDescription>
      </Alert>
      <InstallCommand
        id="install-landing"
        commands={["registry add @buril=https://example.com/r/{name}.json", "add @buril/button"]}
      />
    </div>
    <p class="mt-6">
      <Link href={href("/docs/installation")}>{t("landing.guide")}</Link>
    </p>
  </section>
</BaseLayout>
