---
import BaseLayout from "../layouts/BaseLayout.astro";
import Closing from "./landing/Closing.astro";
import Hero from "./landing/Hero.astro";
import Showcase from "./landing/Showcase.astro";

/**
 * The landing page, shared by `/` and `/es/`. The language comes from the URL; every part reads
 * its copy from the UI dictionary in that language. It shows the product: a short hero, the
 * showcase of real components, then a link to the docs. "Why Buril" lives on the Introduction.
 */
---

<BaseLayout title="Buril UI" footer>
  <Hero />
  <Showcase />
  <Closing />
</BaseLayout>
