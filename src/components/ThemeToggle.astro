---
import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { themeChoices } from "../scripts/theme";
import { translator, type Locale } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const t = translator(Astro.props.locale ?? "en");
const labels = { light: t("theme.light"), dark: t("theme.dark"), system: t("theme.system") };
// The compact button's name for each choice, such as "Theme: Dark".
const current = {
  light: t("theme.current", { choice: labels.light }),
  dark: t("theme.current", { choice: labels.dark }),
  system: t("theme.current", { choice: labels.system }),
};
const iconClass = "size-4 shrink-0";

// Both controls are hidden until the script runs: without JavaScript they could not do anything,
// and the CSS already follows the system preference. From lg up the three buttons show; below lg
// they do not fit one header row, so one icon button cycles Light, Dark and System instead.
---

<div
  role="group"
  aria-label={t("theme.label")}
  data-theme-toggle
  hidden
  class="flex gap-1 max-lg:hidden"
>
  {themeChoices.map((choice) => (
    <button
      type="button"
      data-theme-choice={choice}
      aria-pressed={choice === "system" ? "true" : "false"}
      class={cn(
        buttonVariants({ variant: "ghost", size: "sm" }),
        "px-3 aria-pressed:border-border aria-pressed:bg-secondary aria-pressed:text-secondary-foreground",
      )}
    >
      {labels[choice]}
    </button>
  ))}
</div>

<button
  type="button"
  data-theme-cycle
  hidden
  aria-label={current.system}
  data-labels={JSON.stringify(current)}
  class={cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "lg:hidden")}
>
  <span data-theme-icon="light" hidden aria-hidden="true" class="inline-flex">
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 24 24"
      class={iconClass}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </span>
  <span data-theme-icon="dark" hidden aria-hidden="true" class="inline-flex">
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 24 24"
      class={iconClass}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
    >
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    </svg>
  </span>
  <span data-theme-icon="system" aria-hidden="true" class="inline-flex">
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 24 24"
      class={iconClass}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="4" width="18" height="12" rx="1.5"></rect>
      <path d="M8 20h8M12 16v4"></path>
    </svg>
  </span>
</button>
<span role="status" data-theme-status class="sr-only"></span>

<script>
  import { initThemeCycle, initThemeToggle } from "../scripts/theme";

  for (const group of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    initThemeToggle(group);
    group.hidden = false;
  }
  const status = document.querySelector<HTMLElement>("[data-theme-status]");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-cycle]")) {
    if (!status) break;
    initThemeCycle(button, status);
    button.hidden = false;
  }
</script>
