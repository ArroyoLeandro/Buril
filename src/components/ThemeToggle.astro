---
import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { themeChoices } from "../scripts/theme";

const labels = { light: "Light", dark: "Dark", system: "System" } as const;

// The group is hidden until the script runs: without JavaScript the buttons could not do
// anything, and the CSS already follows the system preference.
---

<div role="group" aria-label="Theme" data-theme-toggle hidden class="flex gap-1">
  {themeChoices.map((choice) => (
    <button
      type="button"
      data-theme-choice={choice}
      aria-pressed={choice === "system" ? "true" : "false"}
      class={cn(
        buttonVariants({ variant: "ghost", size: "sm" }),
        "px-3 aria-pressed:border-border aria-pressed:bg-secondary aria-pressed:text-secondary-foreground",
      )}
    >
      {labels[choice]}
    </button>
  ))}
</div>

<script>
  import { initThemeToggle } from "../scripts/theme";

  for (const group of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    initThemeToggle(group);
    group.hidden = false;
  }
</script>
