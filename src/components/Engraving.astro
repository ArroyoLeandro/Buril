---
/**
 * Decorative guilloche rosette, the kind a burin cuts into banknote plates. Ink lines with one
 * ring in the decor red. It carries no information, so it is hidden from assistive technology.
 *
 * The rings are long paths, so a page draws them once: give the first engraving an `id`, and any
 * other engraving on the page passes that id as `reuse` and only references it with `<use>`. The
 * stroke widths are CSS variables, so each copy keeps its own line weight.
 */
interface Props {
  class?: string;
  /** The ink stroke width in the 200-unit viewBox. A large render wants a thinner line. */
  thin?: number;
  /** The decor ring's stroke width. */
  bold?: number;
  /** The clip path id: give each drawn engraving on a page its own. */
  clipId?: string;
  /** Names the drawing, so another engraving on the page can reuse it. */
  id?: string;
  /** Draws nothing and references the engraving with this id instead. */
  reuse?: string;
}

const { thin = 0.5, bold = 1.25, clipId = "engraving-core", id, reuse } = Astro.props;
const weights = `--engraving-thin: ${thin}; --engraving-bold: ${bold}`;

const center = 100;
const ring = (k: number) => {
  const base = 34 + k * 5.8;
  const amplitude = 2.5 + (k % 3);
  const points = Array.from({ length: 121 }, (_, i) => {
    const t = (i / 120) * Math.PI * 2;
    const r = base + amplitude * Math.sin(12 * t + k * 0.4);
    return `${(center + r * Math.cos(t)).toFixed(1)} ${(center + r * Math.sin(t)).toFixed(1)}`;
  });
  return `M${points.join("L")}Z`;
};
const rings = Array.from({ length: 11 }, (_, k) => ({ d: ring(k), decor: k === 7 }));
const hatching = Array.from({ length: 20 }, (_, i) => -40 + i * 4);
---

<svg
  data-engraving
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 200 200"
  fill="none"
  class={Astro.props.class}
  style={weights}
>
  {reuse ? (
    <use href={`#${reuse}`} />
  ) : (
    <g id={id}>
      <defs>
        <clipPath id={clipId}>
          <circle cx={center} cy={center} r="28" />
        </clipPath>
      </defs>
      <g stroke="currentColor" style="stroke-width: var(--engraving-thin)" class="text-foreground">
        {rings
          .filter(({ decor }) => !decor)
          .map(({ d }) => (
            <path d={d} />
          ))}
        <circle
          cx={center}
          cy={center}
          r="99"
          style="stroke-width: calc(var(--engraving-thin) * 1.5)"
        />
        <circle
          cx={center}
          cy={center}
          r="28"
          style="stroke-width: calc(var(--engraving-thin) * 1.5)"
        />
        <g clip-path={`url(#${clipId})`}>
          {hatching.map((offset) => (
            <line
              x1={center + offset - 30}
              y1={center + 30}
              x2={center + offset + 30}
              y2={center - 30}
            />
          ))}
        </g>
      </g>
      <g stroke="currentColor" style="stroke-width: var(--engraving-bold)" class="text-decor">
        {rings
          .filter(({ decor }) => decor)
          .map(({ d }) => (
            <path d={d} />
          ))}
      </g>
    </g>
  )}
</svg>
