---
import Icon from "./icons/Icon.astro";
import { localeNames, type Locale } from "../i18n/ui";

/**
 * A plain link to the same page in the other language. It shows that language's own name
 * ("Español", "English") and marks it with `lang` and `hreflang`, so screen readers pronounce it
 * correctly and readers of that language recognise it. No redirect ever picks a language for the
 * visitor. A page that is not translated yet shows no switcher. Below sm the globe is dropped, so
 * the header keeps one row on a 320px phone; the language name stays.
 */
interface Props {
  locale: Locale;
  versions: { locale: Locale; href: string }[];
}

const { locale, versions } = Astro.props;
const target = versions.find((version) => version.locale !== locale);
---

{target && (
  <a
    href={target.href}
    hreflang={target.locale}
    lang={target.locale}
    data-language-switcher
    class="inline-flex min-h-8 shrink-0 items-center gap-1 rounded-full px-2 text-sm underline-offset-4 hover:underline"
  >
    <Icon name="globe" class="size-4 max-sm:hidden" />
    {localeNames[target.locale]}
  </a>
)}
