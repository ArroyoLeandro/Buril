---
import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { docsNav } from "../data/docs-nav";
import { getLocale, translator } from "../i18n/ui";
import { slugify } from "../utils/headings";

const locale = getLocale(Astro.url);
const t = translator(locale);
const path = (Astro.url?.pathname ?? "").replace(/(.)\/$/, "$1");
const groups = docsNav(locale);
const statusLabels = { new: t("status.new"), beta: t("status.beta") };
---

<div class="border-b border-border px-4 py-3 sm:px-6 lg:border-b-0 lg:p-0 lg:pt-(--docs-panel-gap)">
  {/*
    Small screens: a disclosure button. It starts hidden and the sidebar starts open, so the
    links work without JavaScript; the script shows the button and collapses the sidebar.
  */}
  <button
    type="button"
    data-docs-nav-toggle
    aria-expanded="false"
    aria-controls="docs-sidebar"
    hidden
    class={cn(buttonVariants({ variant: "outline", size: "sm" }), "lg:hidden")}
  >
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 24 24"
      class="size-4 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    {t("docsNav.menu")}
  </button>
  <nav
    id="docs-sidebar"
    aria-label={t("docsNav.label")}
    class="pt-4 max-lg:data-collapsed:hidden lg:docs-panel lg:border-r lg:border-border lg:px-3 lg:pt-0"
  >
    {groups.map((group) => {
      // Ids stay ASCII and stable across languages: the group's own id, or its category.
      const id = `docs-nav-${slugify(group.id ?? group.category ?? "other")}`;
      return (
        <div class="mb-5 last:mb-0">
          <p id={id} class="px-2 py-1 font-display text-xs text-muted-foreground">
            {group.title}
          </p>
          <ul aria-labelledby={id} class="mt-1 flex flex-col gap-px text-[0.8125rem]">
            {group.items.map(({ name, href, status }) => (
              <li class="flex items-center gap-2">
                <a
                  href={href}
                  aria-current={path === href ? "page" : undefined}
                  class="flex min-h-8 flex-1 items-center px-2 py-1 hover:bg-secondary/60 aria-[current=page]:bg-secondary aria-[current=page]:font-semibold aria-[current=page]:shadow-[inset_2px_0_0_var(--color-decor)] forced-colors:aria-[current=page]:underline"
                >
                  {name}
                </a>
                {status && (
                  <span class="me-2 rounded-full border border-border px-1.5 text-xs">
                    {statusLabels[status]}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </nav>
</div>

<script>
  import { initDocsNav } from "../scripts/docs-nav";

  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-docs-nav-toggle]")) {
    initDocsNav(toggle);
  }
</script>
