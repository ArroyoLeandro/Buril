---
import { getLocale, translator } from "../i18n/ui";
import type { Heading } from "../utils/headings";

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const title = translator(getLocale(Astro.url))("toc.title");
---

{headings.length > 0 && (
  <nav
    aria-label={title}
    class="hidden border-l border-border px-6 py-6 xl:docs-panel xl:block xl:self-start"
  >
    <p class="font-display text-xs text-muted-foreground">{title}</p>
    <ul class="mt-3 flex flex-col gap-2 text-[0.8125rem]">
      {headings.map(({ depth, id, text }) => (
        <li class={depth === 3 ? "ps-3" : undefined}>
          <a
            href={`#${id}`}
            class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
          >
            {text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
