---
import { Code } from "astro:components";

import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { codeTheme } from "./code-theme";
import Icon from "./icons/Icon.astro";
import { packageManagerLogos } from "./icons/package-managers";
import { getLocale, translator } from "../i18n/ui";

interface Props {
  /** Unique on the page; prefixes the tab and panel ids. */
  id: string;
  /** shadcn CLI arguments, one command per line, for example `add @buril/button`. */
  commands: string[];
  /**
   * Whether to explain the example.com placeholder under a command that uses it. Turn it off only
   * when the same section already explains it right above.
   */
  placeholderNote?: boolean;
}

const { id, commands, placeholderNote = true } = Astro.props;
const showNote = placeholderNote && commands.some((command) => command.includes("example.com"));
const t = translator(getLocale(Astro.url));

// The runners shadcn documents for each package manager.
const managers = (
  [
    { name: "npm", runner: "npx" },
    { name: "pnpm", runner: "pnpm dlx" },
    { name: "yarn", runner: "yarn dlx" },
    { name: "bun", runner: "bunx --bun" },
  ] as const
).map((manager) => ({
  ...manager,
  code: commands.map((command) => `${manager.runner} shadcn@latest ${command}`).join("\n"),
}));
---

<div
  data-install-tabs
  data-copied={t("install.copied")}
  data-copy-failed={t("install.copyFailed")}
  class="mt-4"
>
  <div role="tablist" aria-label={t("install.managers")} class="flex flex-wrap gap-1">
    {managers.map((manager, index) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${manager.name}`}
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`${id}-panel-${manager.name}`}
        tabindex={index === 0 ? 0 : -1}
        class={cn(
          buttonVariants({ variant: "ghost", size: "sm" }),
          "px-3 aria-selected:border-border aria-selected:bg-secondary aria-selected:text-secondary-foreground",
        )}
      >
        <svg
          data-logo={manager.name}
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
          class="size-3.5 shrink-0"
        >
          <path d={packageManagerLogos[manager.name]}></path>
        </svg>
        {manager.name}
      </button>
    ))}
  </div>
  {managers.map((manager, index) => (
    <div
      role="tabpanel"
      id={`${id}-panel-${manager.name}`}
      aria-labelledby={`${id}-tab-${manager.name}`}
      hidden={index !== 0}
      class="mt-2 flex flex-col-reverse items-end gap-2 sm:flex-row sm:items-start"
    >
      {/* Below sm the Copy button sits above the command, so the command gets the full width. */}
      <div class="w-full min-w-0 overflow-x-auto text-sm sm:w-auto sm:flex-1 [&_pre]:p-4">
        <Code code={manager.code} lang="bash" theme={codeTheme} />
      </div>
      <button
        type="button"
        data-copy={manager.code}
        aria-label={t("install.copyLabel", { name: manager.name })}
        class={buttonVariants({ variant: "outline", size: "sm" })}
      >
        {/* The copy icon turns into a check while the script marks the button `data-copy-done`. */}
        <Icon name="copy" class="size-4 in-data-copy-done:hidden" />
        <Icon name="check" class="hidden size-4 in-data-copy-done:inline" />
        {t("install.copy")}
      </button>
    </div>
  ))}
  {showNote && <p class="mt-2 text-sm text-muted-foreground">{t("install.placeholder")}</p>}
  <p role="status" data-copy-status class="mt-2 min-h-5 text-sm text-muted-foreground"></p>
</div>

<script>
  import { initInstallTabs } from "../scripts/install-tabs";

  for (const root of document.querySelectorAll<HTMLElement>("[data-install-tabs]")) {
    initInstallTabs(root);
  }
</script>
