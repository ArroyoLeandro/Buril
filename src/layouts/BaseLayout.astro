---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SkipLink } from "../../registry/ui/skip-link";
import { componentHref, documentedComponents } from "../data/components";
import { noFlashScript } from "../scripts/theme";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Accessible React components you copy into your project." } =
  Astro.props;

const path = (Astro.url?.pathname ?? "").replace(/(.)\/$/, "$1");
const current = (href: string) => (path === href ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={noFlashScript} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Silkscreen:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- Static HTML: the browser moves focus to #main, which has tabindex="-1". -->
    <SkipLink />
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-4 px-4 py-3">
        <nav aria-label="Main">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
            <li>
              <a href="/" aria-current={current("/")} class="underline-offset-4 hover:underline">
                Home
              </a>
            </li>
            <li class="flex flex-wrap items-center gap-x-2">
              <span id="nav-components" class="text-muted-foreground">
                Components
              </span>
              <ul aria-labelledby="nav-components" class="flex flex-wrap gap-x-4 gap-y-2">
                {documentedComponents.map(({ slug, name }) => (
                  <li>
                    <a
                      href={componentHref(slug)}
                      aria-current={current(componentHref(slug))}
                      class="underline-offset-4 hover:underline aria-[current=page]:underline"
                    >
                      {name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1" class="mx-auto max-w-2xl px-4 py-12">
      <slot />
    </main>
  </body>
</html>
