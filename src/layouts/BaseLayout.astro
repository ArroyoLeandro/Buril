---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BurilMark from "../components/BurilMark.astro";
import Icon from "../components/icons/Icon.astro";
import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { SkipLink } from "../../registry/ui/skip-link";
import { noFlashScript } from "../scripts/theme";
import { githubUrl, licenseUrl } from "../data/site";
import { alternates, localizedHref } from "../i18n/paths";
import { getLocale, translator } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  /** Docs pages: a sidebar column, the content and an "On this page" column. */
  docs?: boolean;
  /** The site footer, with the license and the source link. Only the landing page shows it. */
  footer?: boolean;
}

const locale = getLocale(Astro.url);
const t = translator(locale);
const { title, description = t("site.description"), docs = false, footer = false } = Astro.props;

const path = (Astro.url?.pathname ?? "").replace(/(.)\/$/, "$1");
const current = (href: string) => (path === href ? "page" : undefined);

const links = [
  { name: t("nav.docs"), href: localizedHref("/docs", locale) },
  { name: t("nav.components"), href: localizedHref("/docs/components", locale) },
];

// Every language version of this page, for search engines and the language switcher. A page that
// is not translated yet lists none. Absolute once `site` is set in the Astro config.
const versions = alternates(path).map((version) => ({
  ...version,
  href: Astro.site ? new URL(version.href, Astro.site).href : version.href,
}));
const defaultVersion = versions.find((version) => version.locale === "en");
const linkClass =
  "rounded-full px-3 py-1.5 underline-offset-4 hover:underline aria-[current=page]:underline";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={noFlashScript} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {versions.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    {defaultVersion && <link rel="alternate" hreflang="x-default" href={defaultVersion.href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Silkscreen:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <!-- Static HTML: the browser moves focus to #main, which has tabindex="-1". -->
    <SkipLink>{t("skipLink")}</SkipLink>
    <header class="border-b border-border bg-background lg:sticky lg:top-0 lg:z-40 lg:h-(--header-height)">
      {/*
        One row at every width. Below md the main links fold behind a menu button (a disclosure,
        like the docs sidebar): the nav starts open and the button hidden, so without JavaScript
        the links still work; the script collapses the nav and shows the button. Below lg the
        theme is one icon button that cycles Light, Dark and System.
      */}
      <div class="flex flex-wrap items-center gap-x-2 gap-y-2 px-4 py-3 sm:gap-x-4 sm:px-6 md:flex-nowrap lg:h-full lg:py-0">
        <a
          href={localizedHref("/", locale)}
          class="inline-flex min-h-10 items-center gap-2 rounded-full font-display max-md:me-auto md:me-2"
        >
          <BurilMark class="size-5.5" />
          <span class="text-lg">Buril UI</span>
        </a>
        <nav
          id="site-nav"
          aria-label={t("nav.main")}
          class="max-md:order-last max-md:basis-full max-md:data-collapsed:hidden md:me-auto lg:flex-1"
        >
          <ul class="flex items-center gap-x-1 gap-y-1 text-sm max-md:flex-col max-md:items-start max-md:pb-1">
            {links.map(({ name, href }) => (
              <li>
                <a href={href} aria-current={current(href)} class={linkClass}>
                  {name}
                </a>
              </li>
            ))}
            <li class="lg:ms-auto">
              <a href={githubUrl} class:list={[linkClass, "inline-flex items-center gap-1.5"]}>
                <svg
                  data-logo="github"
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  class="size-4 shrink-0"
                  fill="currentColor"
                >
                  <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </nav>
        <ThemeToggle locale={locale} />
        <LanguageSwitcher locale={locale} versions={versions} />
        <button
          type="button"
          data-site-nav-toggle
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label={t("nav.menu")}
          hidden
          class={cn(buttonVariants({ variant: "ghost", size: "icon-sm" }), "md:hidden")}
        >
          <Icon name="menu" class="size-4" />
        </button>
      </div>
    </header>
    <div
      class:list={[
        "flex-1",
        docs &&
          "w-full lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_16rem]",
      ]}
    >
      <slot name="sidebar" />
      <main
        id="main"
        tabindex="-1"
        class:list={[
          docs
            ? // A 42rem reading column inside the padding, centred between the panels.
              "mx-auto w-full max-w-[46rem] min-w-0 px-4 py-8 sm:px-8 sm:text-[0.9375rem] sm:leading-[1.75] lg:py-(--docs-panel-gap)"
            : "w-full min-w-0",
        ]}
      >
        <slot />
      </main>
      <slot name="toc" />
    </div>
    {footer && (
      <footer class="border-t border-border">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted-foreground sm:px-6">
          <p>
            {t("footer.licensePrefix")}{" "}
            <a href={licenseUrl} class="text-foreground underline underline-offset-4">
              {t("footer.licenseLink")}
            </a>
          </p>
          <p>
            {t("footer.source")}{" "}
            <a href={githubUrl} class="text-foreground underline underline-offset-4">
              GitHub
            </a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import { initDocsNav } from "../scripts/docs-nav";

      for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-site-nav-toggle]")) {
        initDocsNav(toggle);
      }
    </script>
  </body>
</html>
