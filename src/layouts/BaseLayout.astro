---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SkipLink } from "../../registry/ui/skip-link";
import { noFlashScript } from "../scripts/theme";
import { githubUrl, licenseUrl } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Docs pages: a sidebar column, the content and an "On this page" column. */
  docs?: boolean;
}

const {
  title,
  description = "Accessible React components you copy into your project.",
  docs = false,
} = Astro.props;

const path = (Astro.url?.pathname ?? "").replace(/(.)\/$/, "$1");
const current = (href: string) => (path === href ? "page" : undefined);

const links = [
  { name: "Docs", href: "/docs" },
  { name: "Components", href: "/docs/components" },
];
const linkClass =
  "rounded-full px-3 py-1.5 underline-offset-4 hover:underline aria-[current=page]:underline";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={noFlashScript} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Silkscreen:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <!-- Static HTML: the browser moves focus to #main, which has tabindex="-1". -->
    <SkipLink />
    <header class="border-b border-border">
      <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:px-6">
        <a href="/" class="me-2 inline-flex min-h-10 items-center gap-2 rounded-full font-display">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            class="size-5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M3 21 15 9" stroke-linecap="square"></path>
            <path d="M14 4l6 6-5 5-6-6z" fill="currentColor"></path>
            <path d="M5 21h16" class="text-decor" stroke="currentColor"></path>
          </svg>
          <span class="text-lg">Buril UI</span>
        </a>
        <nav aria-label="Main" class="me-auto">
          <ul class="flex flex-wrap items-center gap-x-1 gap-y-1 text-sm">
            {links.map(({ name, href }) => (
              <li>
                <a href={href} aria-current={current(href)} class={linkClass}>
                  {name}
                </a>
              </li>
            ))}
            <li>
              <a href={githubUrl} class:list={[linkClass, "inline-flex items-center gap-1.5"]}>
                <svg
                  aria-hidden="true"
                  focusable="false"
                  viewBox="0 0 24 24"
                  class="size-4 shrink-0"
                  fill="currentColor"
                >
                  <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <div
      class:list={[
        "flex-1",
        docs &&
          "mx-auto w-full max-w-screen-2xl lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_15rem]",
      ]}
    >
      <slot name="sidebar" />
      <main
        id="main"
        tabindex="-1"
        class:list={[
          docs ? "mx-auto w-full max-w-3xl min-w-0 px-4 py-10 sm:px-8 lg:py-12" : "w-full min-w-0",
        ]}
      >
        <slot />
      </main>
      <slot name="toc" />
    </div>
    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-sm text-muted-foreground sm:px-6">
        <p>
          Buril UI is released under the{" "}
          <a href={licenseUrl} class="text-foreground underline underline-offset-4">
            MIT license
          </a>
          .
        </p>
        <p>
          Source code on{" "}
          <a href={githubUrl} class="text-foreground underline underline-offset-4">
            GitHub
          </a>
          .
        </p>
      </div>
    </footer>
  </body>
</html>
