---
import { Code } from "astro:components";

import DocsLayout from "./DocsLayout.astro";
import InlineCode from "../components/InlineCode.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Tabs from "../components/Tabs.astro";
import TableScroll from "../components/docs/TableScroll.astro";
import { codeTheme } from "../components/code-theme";
import { localizedComponentDocs } from "../data/component-docs";
import { componentDescription, findComponent } from "../data/components";
import { plainDemoSource } from "../i18n/demo-source";
import { getLocale, translator } from "../i18n/ui";
import registry from "../../registry.json";

/**
 * Shared page for one documented component, in the language of its URL. Name, description,
 * install item and source file come from `src/data/components.ts`; usage, API and accessibility
 * from `src/data/component-docs.ts`; the template's own labels from the UI dictionary. The English
 * page and its Spanish twin under `/es/` each pass their own prose through the slots.
 *
 * Sections, in page order: Preview/Code tabs, Installation (CLI/Manual tabs), Usage, Examples,
 * API reference, Accessibility (Keyboard, then ARIA, then notes), then any extra sections. Slots:
 * - `lead`: optional text appended to the description paragraph.
 * - `demo`: the live demo, one React island. The Code tab shows `src/components/<Name>Demo.tsx`.
 * - `install-notes`: optional paragraphs in the CLI tab.
 * - `usage`: optional notes after the usage snippet.
 * - `examples`: optional h3 subsections for variants and states.
 * - default: extra h2 sections after Accessibility, such as migration notes.
 */
interface Props {
  slug: string;
}

const locale = getLocale(Astro.url);
const t = translator(locale);
const entry = findComponent(Astro.props.slug);
const description = componentDescription(entry, locale);
const docs = localizedComponentDocs(entry.slug, locale);

// Every shipped component file and every demo, as raw text at build time: never copied by hand.
const sources = import.meta.glob<string>(
  ["../../registry/ui/*.tsx", "!../../registry/ui/*.test.tsx"],
  { query: "?raw", import: "default", eager: true },
);
const source = sources[`../../${entry.source}`];
if (source === undefined) throw new Error(`Source file not found: ${entry.source}`);

const demos = import.meta.glob<string>(["../components/*Demo.tsx"], {
  query: "?raw",
  import: "default",
  eager: true,
});
const demoName = `${entry.slug.replace(/(^|-)(\w)/g, (_, __, letter: string) => letter.toUpperCase())}Demo`;
// Show the code a consumer writes: imports from components/ui, not this repository's relative
// paths, and plain English strings instead of the docs site's translation helpers.
const raw = demos[`../components/${demoName}.tsx`];
const demoSource =
  raw && plainDemoSource(raw).replace(/(["'])(?:\.\.\/)+registry\/ui\//g, "$1@/components/ui/");

const item = (registry.items as { name: string; dependencies?: string[] }[]).find(
  ({ name }) => name === entry.item,
);
const dependencies = item?.dependencies ?? [];
const fileName = entry.source.split("/").pop() ?? entry.source;

const h2 = "mt-10 font-display text-xl";
const code = "mt-4 overflow-x-auto text-sm [&_pre]:p-4";
const cell = "px-2 py-2 align-top sm:px-4";
// A type breaks between its alternatives: each alternative, with its trailing `|`, stays whole,
// except a long one such as a function type, which may also break at its spaces.
const typeParts = (type: string) =>
  type.split(" | ").map((part, i, all) => ({
    text: i < all.length - 1 ? `${part} |` : part,
    whole: part.length <= 24,
  }));
---

<DocsLayout title={`${entry.name} | Buril UI`} description={description}>
  <h1 class="font-display text-3xl">{entry.name}</h1>
  <p class="mt-4 text-muted-foreground">
    {description}
    <slot name="lead" />
  </p>

  <h2 class={h2}>{t("component.example")}</h2>
  <Tabs
    id="example"
    label={t("component.example")}
    tabs={[
      { id: "preview", label: t("component.preview") },
      { id: "code", label: t("component.code") },
    ]}
  >
    <div slot="preview" class="bg-paper-grid border border-border p-6">
      <slot name="demo" />
    </div>
    <div slot="code" class="text-sm [&_pre]:max-h-[32rem] [&_pre]:overflow-auto [&_pre]:p-4">
      {demoSource ? (
        <Code code={demoSource} lang="tsx" theme={codeTheme} />
      ) : (
        <p class="text-muted-foreground">{t("component.noDemoSource")}</p>
      )}
    </div>
  </Tabs>

  <h2 class={h2}>{t("component.installation")}</h2>
  <Tabs
    id="installation"
    label={t("component.installMethod")}
    tabs={[
      { id: "cli", label: t("component.cli") },
      { id: "manual", label: t("component.manual") },
    ]}
  >
    <div slot="cli">
      <p class="mt-4 text-muted-foreground">{t("component.installFromUrl")}</p>
      <InstallCommand
        id="install-url"
        commands={[`add https://example.com/r/${entry.item}.json`]}
      />
      <p class="mt-4 text-muted-foreground">{t("component.installByName")}</p>
      <InstallCommand
        id="install-namespace"
        commands={[
          "registry add @buril=https://example.com/r/{name}.json",
          `add @buril/${entry.item}`,
        ]}
      />
      <p class="mt-4 text-muted-foreground">
        <InlineCode text={t("component.cnNote")} />
      </p>
      <slot name="install-notes" />
    </div>
    <div slot="manual">
      <ol class="mt-4 list-decimal space-y-4 pl-6">
        {dependencies.length > 0 && (
          <li>
            {t("component.installDependencies")}
            <div class={code}>
              <Code code={`npm install ${dependencies.join(" ")}`} lang="bash" theme={codeTheme} />
            </div>
          </li>
        )}
        <li>
          <InlineCode text={t("component.checkUtils")} />
        </li>
        <li>
          <InlineCode text={t("component.copySource", { file: fileName, source: entry.source })} />
          <div class={code}>
            <Code code={source} lang="tsx" theme={codeTheme} />
          </div>
        </li>
      </ol>
    </div>
  </Tabs>

  {docs && (
    <>
      <h2 class={h2}>{t("component.usage")}</h2>
      <div class={code}>
        <Code code={docs.usage} lang="tsx" theme={codeTheme} />
      </div>
    </>
  )}
  <slot name="usage" />

  {Astro.slots.has("examples") && (
    <>
      <h2 class={h2}>{t("component.examples")}</h2>
      <slot name="examples" />
    </>
  )}

  {docs && (
    <>
      <h2 class={h2}>{t("component.api")}</h2>
      {docs.api.map((api) => (
        <>
          <h3 class="mt-8 font-display text-lg">{api.component}</h3>
          {api.description && (
            <p class="mt-2 text-muted-foreground">
              <InlineCode text={api.description} />
            </p>
          )}
          <TableScroll label={t("component.propsLabel", { name: api.component })}>
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-border">
                  {[
                    t("component.prop"),
                    t("component.type"),
                    t("component.default"),
                    t("component.description"),
                  ].map((header) => (
                    <th scope="col" class={`${cell} font-semibold`}>
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {api.props.map((prop) => (
                  <tr class="border-b border-border last:border-b-0">
                    <th scope="row" class={`${cell} font-normal whitespace-nowrap`}>
                      <code>{prop.name}</code>
                    </th>
                    <td class={cell}>
                      <code class="whitespace-normal">
                        {typeParts(prop.type).map((part, index) => (
                          <>
                            {index > 0 && " "}
                            <span class={part.whole ? "whitespace-nowrap" : undefined}>
                              {part.text}
                            </span>
                          </>
                        ))}
                      </code>
                    </td>
                    <td class={cell}>
                      {prop.default ? (
                        <code class="whitespace-nowrap">{prop.default}</code>
                      ) : prop.defaultText ? (
                        <InlineCode text={prop.defaultText} />
                      ) : (
                        <>
                          <span aria-hidden="true">–</span>
                          <span class="sr-only">{t("component.none")}</span>
                        </>
                      )}
                    </td>
                    {/* Wide enough to read when the table scrolls on a phone. */}
                    <td class={`${cell} min-w-48`}>
                      <InlineCode text={prop.description} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </TableScroll>
        </>
      ))}

      <h2 class={h2}>{t("component.accessibility")}</h2>
      <h3 class="mt-8 font-display text-lg">{t("component.keyboard")}</h3>
      {docs.keyboard && docs.keyboard.length > 0 ? (
        <TableScroll labelledby="keyboard-caption">
          <table class="w-full border-collapse text-left text-sm">
            <caption id="keyboard-caption" class="sr-only">
              {t("component.keyboard")}
            </caption>
            <thead>
              <tr class="border-b border-border">
                <th scope="col" class={`${cell} font-semibold`}>
                  {t("component.key")}
                </th>
                <th scope="col" class={`${cell} font-semibold`}>
                  {t("component.action")}
                </th>
              </tr>
            </thead>
            <tbody>
              {docs.keyboard.map(({ key, action }) => (
                <tr class="border-b border-border last:border-b-0">
                  <th scope="row" class={`${cell} font-normal whitespace-nowrap`}>
                    <kbd class="font-body font-semibold">{key}</kbd>
                  </th>
                  <td class={cell}>{action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </TableScroll>
      ) : (
        <p class="mt-4 text-muted-foreground">{t("component.noKeyboardDetail")}</p>
      )}
      <h3 class="mt-8 font-display text-lg">{t("component.aria")}</h3>
      <dl class="mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
        <dt class="font-semibold">{t("component.role")}</dt>
        <dd>
          <InlineCode text={docs.aria.role} />
        </dd>
        {docs.aria.states && (
          <>
            <dt class="font-semibold">{t("component.states")}</dt>
            <dd>
              <InlineCode text={docs.aria.states} />
            </dd>
          </>
        )}
      </dl>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-muted-foreground">
        {docs.accessibility.map((note) => (
          <li>
            <InlineCode text={note} />
          </li>
        ))}
      </ul>
    </>
  )}

  <slot />
</DocsLayout>
