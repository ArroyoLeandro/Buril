---
import DocsLayout from "../../layouts/DocsLayout.astro";
import ChangelogList from "../../components/docs/ChangelogList.astro";
import { githubUrl } from "../../data/site";
---

<DocsLayout title="Changelog | Buril UI" description="What changed in Buril UI, newest first.">
  <h1 class="font-display text-3xl">Changelog</h1>
  <p class="mt-4 text-lg text-muted-foreground">
    What changed for people who use Buril, newest first. Buril has no version numbers yet: a
    component is up to date when you reinstall it. Every commit is on
    <a href={`${githubUrl}/commits/main`} class="underline underline-offset-4">
      GitHub
    </a>
    .
  </p>
  <ChangelogList />
</DocsLayout>
