---
import { Code } from "astro:components";

import ComponentPage from "../../../layouts/ComponentPage.astro";
import TextareaDemo from "../../../components/TextareaDemo";
import { codeTheme } from "../../../components/code-theme";
import { componentExamples } from "../../../data/snippets";

const { example, statesExample } = componentExamples.textarea;
---

<ComponentPage slug="textarea">
  <Fragment slot="lead">
    It has the Input's border, focus ring, invalid and disabled states, and starts about three lines
    tall.
  </Fragment>

  <TextareaDemo slot="demo" client:visible />

  <Fragment slot="usage">
    <ul class="mt-4 list-disc space-y-2 pl-6 text-muted-foreground">
      <li>
        <strong>Label it.</strong> Put it in a Field, as with the Input, so it gets a visible label,
        its description and its error.
      </li>
      <li>
        <strong>Resizes vertically.</strong> People can make it taller to read long text; the width
        stays with your layout.
      </li>
      <li>
        <strong>Stable error text.</strong> The Field announces a new error politely. Keep the
        message the same while it applies, as the demo does, so screen readers do not hear it on
        every keystroke.
      </li>
    </ul>
  </Fragment>

  <Fragment slot="examples">
    <h3 class="mt-8 font-display text-lg">In a Field</h3>
    <div class="mt-4 overflow-x-auto text-sm [&_pre]:p-4">
      <Code code={example} lang="tsx" theme={codeTheme} />
    </div>

    <h3 class="mt-8 font-display text-lg">Rows and states</h3>
    <p class="mt-4 text-muted-foreground">
      <code>rows</code> sets the starting height; people can still drag it taller. Invalid,
      read-only and disabled work as on the Input. Give an invalid textarea a message through{" "}
      <code>aria-describedby</code>, or put it in a Field, which does it for you.
    </p>
    <div class="mt-4 overflow-x-auto text-sm [&_pre]:p-4">
      <Code code={statesExample} lang="tsx" theme={codeTheme} />
    </div>
  </Fragment>

  <p slot="install-notes" class="mt-4 text-muted-foreground">
    It creates <code data-wrap>components/ui/textarea.tsx</code>, the same path as shadcn's
    Textarea, so existing imports keep working. That is why it is a separate item from the Input
    rather than a second export of <code>input.tsx</code>. It needs only your <code>cn()</code>{" "}
    helper.
  </p>
</ComponentPage>
