---
import { Code } from "astro:components";

import ComponentPage from "../../../layouts/ComponentPage.astro";
import SkeletonDemo from "../../../components/SkeletonDemo";
import { codeTheme } from "../../../components/code-theme";

const usageExample = `import { Skeleton } from "@/components/ui/skeleton";

<section aria-label="Profile" aria-busy={loading || undefined}>
  {loading ? (
    <>
      <Skeleton className="size-12 rounded-full" />
      <Skeleton className="h-4 w-36" />
    </>
  ) : (
    <Profile />
  )}
</section>
{/* On the page from the start, empty. */}
<p role="status">{loaded ? "Profile loaded." : ""}</p>`;
---

<ComponentPage slug="skeleton">
  <Fragment slot="lead">
    It keeps the layout steady while content loads, so nothing jumps when it arrives.
  </Fragment>

  <SkeletonDemo slot="demo" client:visible />

  <Fragment slot="usage">
    <h2 class="mt-10 font-display text-xl">Usage</h2>
    <div class="mt-4 overflow-x-auto text-sm [&_pre]:p-4">
      <Code code={usageExample} lang="tsx" theme={codeTheme} />
    </div>
    <ul class="mt-4 list-disc space-y-2 pl-6 text-muted-foreground">
      <li>
        <strong>Decoration only.</strong> A skeleton is an empty <code>&lt;div&gt;</code> with
        <code>aria-hidden</code>: a gray block means nothing to a screen reader. Shape it with
        <code>className</code> to match the content it stands for.
      </li>
      <li>
        <strong>Mark the region busy.</strong> Put <code>aria-busy="true"</code> on the region that
        is loading, and remove it when the content is in. Some screen readers wait for it to clear
        before reading the region.
      </li>
      <li>
        <strong>Announce completion.</strong> Screen readers do not announce <code>aria-busy</code>
        changing. Say "Profile loaded." from a <code>role="status"</code> region that is already on
        the page, as the demo does.
      </li>
      <li>
        <strong>Reduced motion.</strong> It pulses only when the user has not asked for reduced
        motion. In forced-colors mode, where fills are dropped, a border keeps each block visible.
      </li>
    </ul>
  </Fragment>

  <p slot="install-notes" class="mt-4 text-muted-foreground">
    It creates <code>components/ui/skeleton.tsx</code>, the same path as shadcn's Skeleton. Unlike
    shadcn's, it is <code>aria-hidden</code> and takes no children. It needs only your
    <code>cn()</code> helper; if your <code>lib/utils.ts</code> differs from the current shadcn
    version, the CLI asks before replacing it, and answering no is safe.
  </p>
</ComponentPage>
