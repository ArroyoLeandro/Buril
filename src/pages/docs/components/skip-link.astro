---
import { Code } from "astro:components";

import ComponentPage from "../../../layouts/ComponentPage.astro";
import SkipLinkDemo from "../../../components/SkipLinkDemo";
import { codeTheme } from "../../../components/code-theme";

const usageExample = `import { SkipLink } from "@/components/ui/skip-link";

<body>
  <SkipLink />
  <header>…</header>
  <main id="main" tabIndex={-1}>…</main>
</body>`;
---

<ComponentPage slug="skip-link">
  <Fragment slot="lead">
    This site uses it: press Tab once at the top of any page to see it.
  </Fragment>

  <SkipLinkDemo slot="demo" client:visible />

  <Fragment slot="usage">
    <h2 class="mt-10 font-display text-xl">Usage</h2>
    <div class="mt-4 overflow-x-auto text-sm [&_pre]:p-4">
      <Code code={usageExample} lang="tsx" theme={codeTheme} />
    </div>
    <ul class="mt-4 list-disc space-y-2 pl-6 text-muted-foreground">
      <li>
        <strong>Place it first</strong> in <code>&lt;body&gt;</code>, so it is the first thing a
        keyboard user reaches.
      </li>
      <li>
        <strong>
          Give the target <code>tabindex="-1"</code>.
        </strong>{" "}
        The target can then take focus, and the next Tab continues from the main content instead of
        the top of the page. The default target is <code>#main</code>; pass another with{" "}
        <code>href</code>, such as
        <code>href="#results"</code>, and other text as children.
      </li>
      <li>
        <strong>Hidden until keyboard focus.</strong> It is clipped, not removed, so screen readers
        still find it. On keyboard focus it appears at the top left, above sticky headers, with a
        solid background and the ring outline, so focus is never hidden behind other content (WCAG
        2.4.11).
      </li>
      <li>
        <strong>Works without JavaScript.</strong> It is a plain in-page link. When React runs, it
        also moves focus to the target itself, for browsers that only scroll.
      </li>
    </ul>
  </Fragment>

  <p slot="install-notes" class="mt-4 text-muted-foreground">
    It creates <code>components/ui/skip-link.tsx</code> and needs only your <code>cn()</code>
    helper. If your <code>lib/utils.ts</code> differs from the current shadcn version, the CLI asks
    before replacing it; answering no is safe.
  </p>
</ComponentPage>
