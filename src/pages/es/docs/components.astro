<DocsLayout
  title="Componentes | Buril UI"
  description="Todos los componentes de Buril, agrupados según lo que hacen."
>
  <h1 class="font-display text-3xl">Componentes</h1>
  <p class="mt-4 text-lg text-muted-foreground">
