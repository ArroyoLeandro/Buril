---
import BaseLayout from "../layouts/BaseLayout.astro";
import Engraving from "../components/Engraving.astro";
import InstallCommand from "../components/InstallCommand.astro";
import ButtonsPanel from "../components/showcase/ButtonsPanel";
import SettingsPanel from "../components/showcase/SettingsPanel";
import SignInPanel from "../components/showcase/SignInPanel";
import { cn } from "@/lib/utils";
import { buttonVariants } from "../../registry/ui/button";
import { Link } from "../../registry/ui/link";

const principles = [
  {
    title: "You own the code",
    body: "Components are copied into your project as source, not installed as a dependency. Edit them freely.",
  },
  {
    title: "Accessible by default",
    body: "Every component targets WCAG 2.2 AA and follows its WAI-ARIA pattern, with keyboard and screen reader tests.",
  },
  {
    title: "Platform first",
    body: "Native elements and browser features come before JavaScript: a select stays a select, a link stays a link.",
  },
  {
    title: "Themeable",
    body: "Components read the standard shadcn tokens, so your palette applies without touching a component.",
  },
];

const container = "mx-auto w-full max-w-6xl px-4 sm:px-6";
const sectionTitle = "font-display text-2xl";
const panel = "flex min-w-0 flex-col border border-border bg-background";
const panelTitle = "border-b border-border px-5 py-3 font-display text-base";
---

<BaseLayout title="Buril UI">
  <section class="bg-paper-grid border-b border-border">
    <div class={cn(container, "grid items-center gap-10 py-14 md:grid-cols-[1.2fr_1fr] md:py-20")}>
      <div>
        <h1 class="font-display text-5xl leading-none sm:text-6xl">Buril UI</h1>
        <p class="mt-6 max-w-xl text-xl">
          Accessible React components you copy into your project and make your own.
        </p>
        <p class="mt-4 max-w-xl text-muted-foreground">
          Styled with Tailwind CSS, installed with the shadcn CLI, and tested with the keyboard and
          the accessibility tree in mind.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/docs" class={buttonVariants({ size: "lg" })}>
            Get started
          </a>
          <a href="/docs/components" class={buttonVariants({ variant: "outline", size: "lg" })}>
            Components
          </a>
        </div>
      </div>
      <Engraving class="mx-auto w-full max-w-sm md:max-w-md" />
    </div>
  </section>

  <section aria-labelledby="why" class={cn(container, "py-16")}>
    <h2 id="why" class={sectionTitle}>
      Why Buril
    </h2>
    <ul class="mt-8 grid border-t border-l border-border sm:grid-cols-2 lg:grid-cols-4">
      {principles.map(({ title, body }) => (
        <li class="border-r border-b border-border p-6">
          <h3 class="font-display text-base">{title}</h3>
          <p class="mt-3 text-sm text-muted-foreground">{body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="at-work" class="border-y border-border bg-secondary/40 py-16">
    <div class={container}>
      <h2 id="at-work" class={sectionTitle}>
        Components at work
      </h2>
      <p class="mt-4 max-w-2xl text-muted-foreground">
        These panels use the same files the registry ships. Try them with the keyboard: every
        control has a visible focus ring and a label, and each change is announced.
      </p>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        <section aria-labelledby="panel-sign-in" class={panel}>
          <h3 id="panel-sign-in" class={panelTitle}>
            Sign in
          </h3>
          <div class="p-5">
            <SignInPanel client:visible />
          </div>
        </section>
        <section aria-labelledby="panel-settings" class={panel}>
          <h3 id="panel-settings" class={panelTitle}>
            Notifications
          </h3>
          <div class="p-5">
            <SettingsPanel client:visible />
          </div>
        </section>
        <section aria-labelledby="panel-buttons" class={panel}>
          <h3 id="panel-buttons" class={panelTitle}>
            Buttons
          </h3>
          <div class="p-5">
            <ButtonsPanel client:visible />
          </div>
        </section>
      </div>
    </div>
  </section>

  <section aria-labelledby="install" class={cn(container, "py-16")}>
    <h2 id="install" class={sectionTitle}>
      Install
    </h2>
    <p class="mt-4 max-w-2xl text-muted-foreground">
      In a project set up with shadcn, add the Buril namespace once, then install components by
      name.
    </p>
    <div class="max-w-3xl">
      <InstallCommand
        id="install-landing"
        commands={["registry add @buril=https://example.com/r/{name}.json", "add @buril/button"]}
      />
    </div>
    <p class="mt-6">
      <Link href="/docs/installation">Read the installation guide</Link>
    </p>
  </section>
</BaseLayout>
