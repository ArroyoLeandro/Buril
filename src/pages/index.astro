---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buttonVariants } from "../../registry/ui/button";
---

<BaseLayout title="Buril UI">
  <h1 class="font-display text-3xl">Buril UI</h1>
  <p class="mt-4 text-muted-foreground">Accessible React components you copy into your project.</p>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a href="/components/button" class={buttonVariants()}>
      Browse the Button
    </a>
    <div
      role="img"
      aria-label="Hatched block using the decorative color"
      class="size-16 border border-border"
      style="background-image: repeating-linear-gradient(45deg, var(--color-decor) 0 2px, transparent 2px 8px)"
    ></div>
  </div>

  <p class="mt-8 border border-border p-4 dark:border-decor">
    Border and text follow the active color scheme.
  </p>
</BaseLayout>
